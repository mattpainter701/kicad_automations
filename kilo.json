{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "rules/kicad.md"
  ],
  "skills": {
    "paths": [
      "./skills",
      "./project-skills"
    ]
  },
  "agent": {
    "bom-auditor": {
      "description": "Audit a KiCad design's BOM state for ordering readiness and schematic consistency.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "write": {
          "*": "deny",
          "*/bom/*": "allow"
        },
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git commit*": "deny",
          "git add*": "deny",
          "rm *": "deny",
          "del *": "deny",
          "Remove-Item*": "deny",
          "rmdir *": "deny"
        }
      }
    },
    "hardware-reviewer": {
      "description": "Review KiCad schematics, PCB layouts, BOMs, and generated reports for correctness, fabrication readiness, and presentation quality.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git commit*": "deny",
          "git add*": "deny",
          "rm *": "deny",
          "del *": "deny",
          "Remove-Item*": "deny",
          "rmdir *": "deny"
        }
      }
    }
  }
}
