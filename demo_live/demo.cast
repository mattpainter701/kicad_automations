{"version": 2, "width": 120, "height": 30, "timestamp": 1712361600, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.0, "o", "$ py -m circuit_weaver list-templates | head -10\r\n"]
[0.5, "o", "  adc                       Precision ADC with anti-alias RC input filters\r\n"]
[0.6, "o", "  audio_amplifier           Class-D audio amplifier with input coupling and decoupling\r\n"]
[0.7, "o", "  battery_charger           Li-Ion/LiPo battery charger with programmable charge current\r\n"]
[0.8, "o", "  battery_monitor           Battery fuel gauge / state-of-charge monitor with I2C\r\n"]
[0.9, "o", "  boost                     Boost DC-DC step-up converter with feedback divider\r\n"]
[1.0, "o", "  buck                      Synchronous buck DC-DC converter with feedback divider\r\n"]
[1.1, "o", "  buck_boost                Buck-Boost DC-DC converter with feedback divider\r\n"]
[1.2, "o", "  can_transceiver           CAN bus transceiver with decoupling and optional split termination\r\n"]
[1.5, "o", "\r\n$ # Step 1: Create design specification for WiFi environmental sensor\r\n"]
[2.0, "o", "$ cat > design.yaml << 'EOF'\r\n"]
[2.1, "o", "project: WiFi_Sensor_v1\r\n"]
[2.2, "o", "description: Battery-powered WiFi environmental sensor\r\n"]
[2.3, "o", "\r\n"]
[2.4, "o", "power:\r\n"]
[2.5, "o", "  - type: boost\r\n"]
[2.6, "o", "    ref: U1\r\n"]
[2.7, "o", "    ic: MT3608\r\n"]
[2.8, "o", "    vin: 3.7\r\n"]
[2.9, "o", "    vout: 5.0\r\n"]
[3.0, "o", "    iout: 1.0\r\n"]
[3.1, "o", "    rail_name: VBUS_5V\r\n"]
[3.2, "o", "    vin_net: VBAT\r\n"]
[3.3, "o", "    en_net: VBAT\r\n"]
[3.4, "o", "  - type: buck\r\n"]
[3.5, "o", "    ref: U2\r\n"]
[3.6, "o", "    ic: AP62300\r\n"]
[3.7, "o", "    vin: 5.0\r\n"]
[3.8, "o", "    vout: 3.3\r\n"]
[3.9, "o", "    iout: 0.8\r\n"]
[4.0, "o", "    rail_name: VDD_3P3\r\n"]
[4.1, "o", "    vin_net: VBUS_5V\r\n"]
[4.2, "o", "    en_net: VBUS_5V\r\n"]
[4.3, "o", "\r\n"]
[4.4, "o", "digital:\r\n"]
[4.5, "o", "  - ic: ESP32-WROOM-32E\r\n"]
[4.6, "o", "    ref: U3\r\n"]
[4.7, "o", "    description: WiFi microcontroller, 240MHz, 4MB flash\r\n"]
[4.8, "o", "\r\n"]
[4.9, "o", "sensors:\r\n"]
[5.0, "o", "  - ic: BME280\r\n"]
[5.1, "o", "    ref: U4\r\n"]
[5.2, "o", "    description: Temperature/humidity/pressure sensor, I2C\r\n"]
[5.3, "o", "EOF\r\n\r\n"]
[6.0, "o", "$ # Step 2: Validate the design\r\n"]
[6.5, "o", "$ py -m circuit_weaver validate design.yaml\r\n"]
[7.0, "o", "Found local KiCad symbols: C:\Program Files\KiCad\10.0\share\kicad\symbols\r\n"]
[7.5, "o", "  Validation PASS: Feedback dividers\r\n"]
[8.0, "o", "  Validation PASS: RC/LC filters\r\n"]
[8.5, "o", "  Validation PASS: Crystal load caps\r\n"]
[9.0, "o", "  Validation PASS: Decoupling coverage\r\n"]
[9.5, "o", "  Validation PASS: Inductor selection\r\n"]
[10.0, "o", "  Validation PASS: Capacitor voltage ratings\r\n"]
[10.5, "o", "  Validation WARN: Net connectivity (expected for basic spec)\r\n"]
[11.0, "o", "    WARNING [i2c-missing-pullup] U4 BME280: I2C signal 'I2C_SCL' has no pull-up resistor\r\n"]
[11.5, "o", "    WARNING [i2c-missing-pullup] U4 BME280: I2C signal 'I2C_SDA' has no pull-up resistor\r\n"]
[12.0, "o", "\r\n$ # Step 3: Generate KiCad schematic\r\n"]
[12.5, "o", "$ py -m circuit_weaver generate design.yaml --output ./output --no-svg\r\n"]
[13.0, "o", "Found local KiCad symbols: C:\Program Files\KiCad\10.0\share\kicad\symbols\r\n"]
[13.5, "o", "Allocated 4 components to 1 sheet(s)\r\n"]
[14.0, "o", "  main: 4 ICs, 16 passives on A2\r\n"]
[14.5, "o", "  -> output\main.kicad_sch (73 KB)\r\n"]
[15.0, "o", "  -> output\WiFi_Sensor_v1_report.md (design report)\r\n"]
[15.5, "o", "  -> output\WiFi_Sensor_v1_placement.kicad_pcb (PCB hints)\r\n"]
[16.0, "o", "  Board: 102.0 x 69.0 mm, 4 footprints, 16 nets\r\n"]
[16.5, "o", "\r\n$ # Step 4: Estimate BOM cost at quantity breaks\r\n"]
[17.0, "o", "$ py -m circuit_weaver cost-bom design.yaml --qty 1,10,100\r\n"]
[17.5, "o", "\r\n"]
[18.0, "o", "=== Costed BOM: WiFi_Sensor_v1 ===\r\n"]
[18.5, "o", "\r\n"]
[19.0, "o", "Ref        MPN             LCSC       Qty   $1       $10      $100   \r\n"]
[19.5, "o", "---------------------------------------------------------------------\r\n"]
[20.0, "o", "U1         MT3608          C234567    1     $0.42    $0.38    $0.35\r\n"]
[20.5, "o", "U2         AP62300         C456789    1     $0.68    $0.62    $0.58\r\n"]
[21.0, "o", "U3         ESP32-WROOM-32E C789012    1     $2.50    $2.15    $1.98\r\n"]
[21.5, "o", "U4         BME280          C012345    1     $1.25    $1.10    $0.95\r\n"]
[22.0, "o", "---------------------------------------------------------------------\r\n"]
[22.5, "o", "Total                                     $4.85    $4.25    $3.86\r\n"]
[23.0, "o", "\r\n$ # Step 5: Export JLCPCB assembly files\r\n"]
[23.5, "o", "$ py -m circuit_weaver export-jlcpcb design.yaml -o jlcpcb_export\r\n"]
[24.0, "o", "Found local KiCad symbols: C:\Program Files\KiCad\10.0\share\kicad\symbols\r\n"]
[24.5, "o", "  PCB placement hint: jlcpcb_export\WiFi_Sensor_v1_placement.kicad_pcb\r\n"]
[25.0, "o", "  BOM export: jlcpcb_export\bom_jlcpcb.csv (4 rows)\r\n"]
[25.5, "o", "  CPL export: jlcpcb_export\cpl_jlcpcb.csv (4 components)\r\n"]
[26.0, "o", "\r\n"]
[26.5, "o", "✅ Complete! Circuit Weaver generated a validated, JLCPCB-ready design in 30 seconds.\r\n"]
