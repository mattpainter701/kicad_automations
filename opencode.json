{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "plugin": [
    "@xtruder/opencode-claude-max-plugin",
    "oh-my-openagent",
    "opencode-agent-skills",
    "opencode-agent-memory",
    "@gotgenes/opencode-agent-identity"
  ],
  "instructions": [
    "AGENTS.md",
    "rules/kicad.md"
  ],
  "skills": { "paths": [".agents/skills"] },
  "agent": {
    "build": {
      "description": "Default development agent with full tool access",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-flash"
    },
    "plan": {
      "description": "Planning and analysis agent (read-only, no edits)",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-flash",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "ask"
      }
    }
  }
}
