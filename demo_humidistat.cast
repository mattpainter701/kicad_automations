[67.71, "o", "Board: 50.0x40.0 mm, Qty: 100\r\n"]
[67.73, "o", "  Option 1 (recommended): 1x2 = 2/panel (60.0x92.0 mm, 72.5% util, 50 panels, 0 waste)\r\n"]
[67.75, "o", "  Cost: panelized $25.00 ($0.2500/board) vs single $40.00 ($0.4000/board) — 38% savings\r\n"]
[67.77, "o", "  Rule: Keep copper >= 0.3mm from board edge for v-cut\r\n"]
[67.79, "o", "  Rule: V-cut: no copper on breakaway line; boards must have straight edges\r\n"]
[67.81, "o", "  Rule: V-cut boards must be rectangular (no internal cutouts crossing the cut)\r\n"]
[67.83, "o", "  Rule: Preserve at least one fiducial per board for pick-and-place alignment\r\n"]
