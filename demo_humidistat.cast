[7.98, "o", "\r\n"]
[8.28, "o", "  adc                       Precision ADC with anti-alias RC input filters\r\n"]
[8.3, "o", "    params: ic, ref, vdd_net, input_filter_bw, channels, i2c_addr, sda_net, scl_net, cs_net, spi_mosi_net, spi_miso_net, spi_sck_net, vref_net\r\n"]
[8.32, "o", "  audio_amplifier           Class-D audio amplifier with input coupling and decoupling\r\n"]
[8.34, "o", "    params: ic, ref, vdd_net, audio_in_net, f_low, speaker_impedance\r\n"]
[8.36, "o", "  battery_charger           Li-Ion/LiPo battery charger with programmable charge current\r\n"]
[8.38, "o", "    params: ichg*, vcell, ic, ref, vin_net, bat_net, stat_net\r\n"]
[8.4, "o", "  battery_monitor           Battery fuel gauge / state-of-charge monitor with I2C\r\n"]
[8.42, "o", "    params: ic, ref, bat_net, cell_capacity_mah, rsense, i2c_bus\r\n"]
[8.44, "o", "  boost                     Boost DC-DC step-up converter with feedback divider\r\n"]
[8.46, "o", "    params: vin*, vout*, iout*, ic, ref, rail_name, vin_net, en_net, fsw, r_fbb\r\n"]
[8.48, "o", "  buck                      Synchronous buck DC-DC converter with feedback divider\r\n"]
[8.5, "o", "    params: vin*, vout*, iout*, ic, ref, rail_name, vin_net, en_net, fsw, r_fbb, ripple_ratio, vout_ripple\r\n"]
[8.52, "o", "  buck_boost                Buck-Boost DC-DC converter with feedback divider\r\n"]
[8.54, "o", "    params: vin*, vout*, iout*, vin_min, vin_max, ic, ref, rail_name, vin_net, en_net, r_fbb\r\n"]
[8.56, "o", "  can_transceiver           CAN bus transceiver with decoupling and optional split termination\r\n"]
[8.58, "o", "    params: ic, ref, vdd_net, txd_net, rxd_net, bus_net_prefix, termination, slope_control\r\n"]
[8.6, "o", "  charge_pump               Inverting charge pump with flying cap and output cap\r\n"]
[8.62, "o", "    params: ic, ref, vin_net, rail_name, iout\r\n"]
[8.64, "o", "  clock_synth               Clock synthesizer IC with decoupling and PLL loop filter\r\n"]
[8.66, "o", "    params: ic, ref, ref_freq, pll_bw, vdd_net, vddo_net, ref_net\r\n"]
[8.68, "o", "  crystal_oscillator        Crystal oscillator with load capacitors and feedback resistor\r\n"]
[8.7, "o", "    params: freq*, cl_spec*, c_stray, ic, ref, xtal_in_net, xtal_out_net\r\n"]
[8.72, "o", "  current_sense             High-side current sense amplifier with auto-calculated Rsense\r\n"]
[8.74, "o", "    params: imax*, vsense_target, ic, ref, vdd_net, sense_p_net, sense_n_net, sda_net, scl_net, out_net\r\n"]
[8.76, "o", "  dac                       Digital-to-analog converter with output RC filter\r\n"]
[8.78, "o", "    params: ic, ref, vdd_net, update_rate, vref, output_net, sda_net, scl_net, din_net, sclk_net, sync_net, output_b_net\r\n"]
[8.8, "o", "  display_driver            OLED/LCD display driver with reset circuit and interface config\r\n"]
[8.82, "o", "    params: ic, ref, interface, vdd_net, resolution, backlight, bl_current, bl_vf\r\n"]
[8.84, "o", "  ... (32 more lines)\r\n"]
